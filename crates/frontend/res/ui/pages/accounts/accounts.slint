import { HorizontalBox, Palette, StyleMetrics, VerticalBox, Button, GroupBox, LineEdit } from "std-widgets.slint";
import { HorizontalSpacing, SubTitle, SettingsGroup, MyText, VerticalSpacing } from "../../components/components.slint";
import { Account } from "account-item.slint";
import { AccountInner, AccountType } from "account-inner.slint";
import { AccountsList } from "accounts-list.slint";

export { AccountInner }
export { AccountIconSpec } from "account-item.slint";

export component AccountsPage inherits VerticalBox {
    in-out property <int> current-index;
    in-out property <[AccountInner]> accounts;

    callback open-login-dialog();
    callback del-acc(int);
    callback edit-acc(int, AccountInner);
    callback switch-acc(int);

    property <bool> edit: false;
    property <bool> switch: false;

    Rectangle {
        background: Palette.control-background;
        border-radius: 8px;
        vertical-stretch: 0;

        VerticalBox {
            HorizontalLayout {
                Account {
                    account: accounts[current-index];
                }

                HorizontalSpacing {}

                // Buttons
                VerticalLayout {
                    spacing: StyleMetrics.layout-spacing;

                    edit-btn := Button {
                        text: @tr("Edit");
                        clicked => {
                            edit = !edit;
                            switch = false;
                        }
                    }

                    switch-btn := Button {
                        text: @tr("Switch");
                        clicked => {
                            edit = false;
                            switch = !switch;
                        }
                    }
                }
            }

            if (edit): VerticalLayout {
                spacing: StyleMetrics.layout-spacing;
                
                SettingsGroup {
                    title: @tr("Edit {}", accounts[current-index].user-name);
                    Row {
                        MyText {
                            text: @tr("Name");
                        }
                        LineEdit {
                            text: accounts[current-index].user-name;
                            // 在线账户（MSA）账号信息不能修改
                            read-only: accounts[current-index].account-type == AccountType.MSA;
                            edited(text) => {
                                accounts[current-index].user-name = text;
                                edit-acc(current-index, accounts[current-index])
                            }
                        }
                    }
                    Row {
                        MyText {
                            text: @tr("UUID");
                        }
                        LineEdit {
                            text: accounts[current-index].uuid;
                            read-only: accounts[current-index].account-type == AccountType.MSA;
                            edited(text) => {
                                accounts[current-index].uuid = text;
                                edit-acc(current-index, accounts[current-index])
                            }
                        }
                    }
                    Row {
                        MyText {
                            text: @tr("Token");
                        }
                        LineEdit {
                            text: accounts[current-index].token;
                            read-only: accounts[current-index].account-type == AccountType.MSA;
                            // 离线账户的 token 不可编辑
                            enabled: accounts[current-index].account-type != AccountType.Legacy;
                            edited(text) => {
                                accounts[current-index].token = text;
                                edit-acc(current-index, accounts[current-index])
                            }
                        }
                    }
                }

                HorizontalLayout {
                    HorizontalSpacing {}
                    Button {
                        text: @tr("Delete");
                        clicked => del-acc(current-index);
                    }
                }
            }

            if (switch): VerticalLayout {
                spacing: StyleMetrics.layout-spacing;

                AccountsList {
                    accounts: accounts;
                    current-index <=> root.current-index;
                    selected(index) => switch-acc(index);
                }

                HorizontalLayout {
                    HorizontalSpacing {}
                    Button {
                        text: @tr("Add");
                        clicked => open-login-dialog();
                    }
                }
            }
        }
    }

    VerticalSpacing {}
}