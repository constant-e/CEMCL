import { HorizontalBox, VerticalBox, Palette, StyleMetrics } from "std-widgets.slint";
import { SideBarItem } from "sidebar-item.slint";
import { SubTitle } from "../general/general.slint";

export component SideBar inherits Rectangle {
    in-out property <[string]> model: [];
    in-out property <string> title <=> label.text;
    in-out property <int> current-index;
    // Height of the header row; the window keeps it in sync with the title bar
    in property <length> header-height: 40px;
    property <int> last-index: current-index;

    callback index-changed(from: int, to: int);

    min-width: 150px;

    Rectangle {
        background: Palette.alternate-background;
    }

    VerticalBox {
        padding-left: 0px;
        padding-right: 0px;
        padding-top: 0px;
        padding-bottom: 0px;
        alignment: start;

        header := Rectangle {
            height: root.header-height;

            label := SubTitle {
                width: 100%;
                height: 100%;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            for item[index] in root.model : SideBarItem {
                clicked => {
                    index-changed(last-index, current-index);
                    last-index = current-index;
                    current-index = index;
                }
                text: item;
                selected: index == root.current-index;
            }
        }
    }
}
