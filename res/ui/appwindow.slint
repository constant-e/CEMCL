import { Button, StandardTableView, VerticalBox, HorizontalBox, ProgressIndicator } from "std-widgets.slint";
import { Title, SubTitle, SideBar } from "components/components.slint";
import { AccountsPage, HomePage, GamesPage, DownloaderPage, SettingsPage, State, Config, ConfigGeneral, ConfigDL, ConfigMC } from "pages/pages.slint";
import { AccountInner } from "pages/accounts/accounts.slint";

export { Config, ConfigGeneral, ConfigDL, ConfigMC, State }
export { Messages } from "messages.slint";
export { AddGameDialog, EditGameDialog, AskDialog, MsgDialog, LoginDialog } from "dialogs/dialogs.slint";

export component AppWindow inherits Window {
    preferred-height: 600px;
    preferred-width: 800px;
    title: "CE Minecraft Launcher";
    icon: @image-url("../pic/icon.png");

    in-out property <int> acc-index: 0;
    in-out property <int> game-index: 0;
    in-out property <[AccountInner]> acc-list;
    in-out property <[string]> combo-box-model;
    in-out property <[[StandardListViewItem]]> game-model;
    in-out property <State> state;
    in-out property <Config> config;
    in-out property <string> authors;
    in-out property <string> version;
    in-out property <float> progress;

    callback click-add-acc-btn();
    callback click-add-game-btn();
    callback click-downloader-btn();
    callback del-acc(int);
    callback edit-acc(int, AccountInner);
    callback click-edit-game-btn(index: int);
    callback apply-settings();
    callback click-start-btn(index: int);
    
    HorizontalBox {
        padding: 0px;

        side-bar := SideBar {
            title: "CEMCL";
            model: [@tr("Account"), @tr("Home"), @tr("Games"), @tr("Downloader"), @tr("Settings")];
            current-index: 1;

            index-changed(from, to) => {
                if (from == 4){
                    root.apply-settings();
                }
                if (to == 3) {
                    root.click-downloader-btn();
                }
            }
        }

        Rectangle {
            preferred-width: 100%;

            if (side-bar.current-index == 0): acc-page := AccountsPage {
                current-index: acc-index;
                accounts: acc-list;
                click-add-btn() => { click-add-acc-btn() }
                edited(index, account) => { edit-acc(index, account) }
                click-switch-btn(index) => { acc-index = index }
                click-del-btn(index) => { del-acc(index) }
            }

            if (side-bar.current-index == 1): home-page := HomePage {
                state: state;
                model: combo-box-model;
                progress: progress;
                click-start-btn(index) => { click-start-btn(index) }
            }

            if (side-bar.current-index == 2): games-page := GamesPage {
                current-index: game-index;
                model: game-model;
                click-add-btn => { click-add-game-btn() }
                click-edit-btn(index) => { click-edit-game-btn(index) }
                current-index-changed(current-index) => { root.game-index = current-index }
            }

            if (side-bar.current-index == 3): downloader-page := DownloaderPage {}

            if (side-bar.current-index == 4): settings-page := SettingsPage {
                authors: authors;
                version: version;
                config: config;
                settings-changed() => { root.config = self.config; root.apply-settings() }
            }
        }
    }
}
