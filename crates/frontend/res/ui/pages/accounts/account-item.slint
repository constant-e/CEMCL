import { SubTitle } from "../../components/components.slint";
import { AccountInner, AccountType } from "account-inner.slint";
import { StyleMetrics } from "std-widgets.slint";

// Icon size of an account avatar: Rust generates the bitmap for this size
// multiplied by the window scale factor, so that it is not scaled up and blurred
export global AccountIconSpec {
    out property <length> size: 48px;
}

export component Account inherits HorizontalLayout {
    spacing: StyleMetrics.layout-spacing;

    in-out property <AccountInner> account;
    in-out property <length> size: AccountIconSpec.size;

    function to-string(type: AccountType) -> string {
        if type == AccountType.Legacy {
            return @tr("Offline");
        } else if type == AccountType.MSA {
            return @tr("Microsoft");
        } else {
            return @tr("Other");
        }
    }

    // User avatar: front face of the account's skin
    avatar := Image {
        source: account.avatar;
        width: size;
        height: size;
    }

    // User ID and type
    VerticalLayout {
        spacing: StyleMetrics.layout-spacing;

        id := SubTitle {
            horizontal-alignment: left;
            vertical-alignment: bottom;
            text: account.user-name;
        }
        type := Text {
            horizontal-alignment: left;
            vertical-alignment: top;
            text: to-string(account.account-type);
        }
    }
}