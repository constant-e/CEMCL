import { HorizontalBox, ProgressIndicator, VerticalBox, ComboBox, Button } from "std-widgets.slint";
import { HorizontalSpacing, VerticalSpacing } from "../components/components.slint";

export enum State {
    Spare,
    Downloading,
    Launching,
    LoggingIn
}

export component HomePage inherits VerticalBox {
    in-out property <int> index <=> combo-box.current-index;
    in-out property <[string]> model <=> combo-box.model;
    in-out property <State> state;
    in-out property <float> progress;
    // 0 = BySize, 1 = ByNumber, 2 = Both
    in-out property <int> progress-mode;
    in-out property <int> progress-current;
    in-out property <int> progress-total;

    callback current-index-changed(index: int);
    callback start(index: int);

    function progress-text() -> string {
        if progress-mode == 1 {
            // 按数量：显示 "完成数/总数"
            return progress-current + "/" + progress-total;
        } else if progress-mode == 2 {
            // 均显示：百分比后显示 " (完成数/总数)"
            return round(progress * 100) + "% (" + progress-current + "/" + progress-total + ")";
        } else {
            // 按大小：原有逻辑
            return round(progress * 100) + "%";
        }
    }

    states [
        spare when state == State.Spare: {
            progress-area.visible: false;
            state-text.text: "";
        }
        downloading when state == State.Downloading: {
            progress-area.visible: true;
            state-text.text: @tr("Downloading");
        }
        launching when state == State.Launching: {
            progress-area.visible: true;
            state-text.text: @tr("Launching");
        }
        logging-in when state == State.LoggingIn: {
            progress-area.visible: true;
            state-text.text: @tr("Logging in");
        }

    ]

    VerticalSpacing {}

    HorizontalLayout {
        combo-box := ComboBox {
            horizontal-stretch: 0;
            enabled: state == State.Spare;
            selected => {
                root.current-index-changed(index);
            }
        }

        progress-area := HorizontalBox {

            visible: false;
            preferred-width: 100%;
    
            state-text := Text {
                vertical-alignment: center;
            }
    
            ProgressIndicator {
                progress: progress;
            }
    
            Text {
                vertical-alignment: center;
                horizontal-alignment: right;
                text: progress-text();
            }
        }

        start-btn := Button {
            text: @tr("Start");
            enabled: state == State.Spare && combo-box.model.length != 0;
            clicked => {
                root.start(combo-box.current-index);
            }
        }
    }
}