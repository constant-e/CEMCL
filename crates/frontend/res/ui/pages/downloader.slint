import { ProgressIndicator, VerticalBox, HorizontalBox, Button, ScrollView, StyleMetrics, Palette } from "std-widgets.slint";
import { Title, SectionTitle, HorizontalSpacing, VerticalSpacing } from "../components/components.slint";

export enum TaskSetStatus {
    Pending,
    Downloading,
    Paused,
    Completed,
    Failed,
    Cancelled
}

export struct TaskSetInfo {
    id: string,
    status: TaskSetStatus,
    downloaded: float,
    total: float,
    downloaded-num: int,
    total-num: int
}

component TaskSetItem inherits Rectangle {
    background: Palette.control-background;
    border-radius: 8px;
    vertical-stretch: 0;

    in property <TaskSetInfo> info;
    in property <bool> finished;
    // 0 = BySize, 1 = ByNumber, 2 = Both
    in property <int> progress-mode;

    callback pause();
    callback resume();
    callback cancel();

    function status-text(status: TaskSetStatus) -> string {
        if status == TaskSetStatus.Pending {
            return @tr("Pending");
        } else if status == TaskSetStatus.Downloading {
            return @tr("Downloading");
        } else if status == TaskSetStatus.Paused {
            return @tr("Paused");
        } else if status == TaskSetStatus.Completed {
            return @tr("Completed");
        } else if status == TaskSetStatus.Failed {
            return @tr("Failed");
        } else {
            return @tr("Cancelled");
        }
    }

    function progress-text(info: TaskSetInfo) -> string {
        if progress-mode == 1 {
            // 按数量：显示 "完成数/总数"
            return info.downloaded-num + "/" + info.total-num;
        } else if progress-mode == 2 {
            // 均显示：百分比后显示 " (完成数/总数)"
            if info.total > 0 {
                return round(info.downloaded * 100 / info.total) + "% (" + info.downloaded-num + "/" + info.total-num + ")";
            } else {
                return "0% (" + info.downloaded-num + "/" + info.total-num + ")";
            }
        } else {
            // 按大小：原有逻辑
            if info.total > 0 {
                return round(info.downloaded * 100 / info.total) + "%";
            } else {
                return "0%";
            }
        }
    }

    function progress-value(info: TaskSetInfo) -> float {
        if progress-mode == 1 {
            return info.total-num > 0 ? info.downloaded-num * 1.0 / info.total-num : 0;
        } else {
            return info.total > 0 ? info.downloaded / info.total : 0;
        }
    }

    VerticalBox {
        HorizontalLayout {
            id-text := Text {
                text: info.id;
                horizontal-alignment: left;
                vertical-alignment: center;
            }

            status-label := Text {
                text: status-text(info.status);
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: StyleMetrics.layout-spacing;
            ProgressIndicator {
                progress: progress-value(info);
            }

            progress-label := Text {
                text: progress-text(info);
                vertical-alignment: center;
            }
        }

        if !finished: HorizontalLayout {
            spacing: StyleMetrics.layout-spacing;

            HorizontalSpacing {}

            pause-btn := Button {
                text: @tr("Pause");
                enabled: info.status == TaskSetStatus.Downloading || info.status == TaskSetStatus.Pending;
                clicked => { pause(); }
            }

            resume-btn := Button {
                text: @tr("Resume");
                enabled: info.status == TaskSetStatus.Paused;
                clicked => { resume(); }
            }

            cancel-btn := Button {
                text: @tr("Cancel");
                enabled: info.status != TaskSetStatus.Completed && info.status != TaskSetStatus.Failed && info.status != TaskSetStatus.Cancelled;
                clicked => { cancel(); }
            }
        }
    }
}

export component DownloaderPage inherits VerticalBox {
    in property <[TaskSetInfo]> unfinished-list;
    in property <[TaskSetInfo]> finished-list;
    // 0 = BySize, 1 = ByNumber, 2 = Both
    in property <int> progress-mode;

    callback pause(string);
    callback resume(string);
    callback cancel-task(string);

    Title { text: @tr("Downloader"); }

    SectionTitle { text: @tr("Unfinished"); }

    ScrollView {
        VerticalLayout {
            spacing: StyleMetrics.layout-spacing;

            for info in unfinished-list:
                TaskSetItem {
                    info: info;
                    finished: false;
                    progress-mode: root.progress-mode;
                    pause() => { root.pause(info.id); }
                    resume() => { root.resume(info.id); }
                    cancel() => { root.cancel-task(info.id); }
                }
            
            VerticalSpacing {}
        }
    }

    SectionTitle { text: @tr("Finished"); }

    ScrollView {
        VerticalLayout {
            spacing: StyleMetrics.layout-spacing;

            for info in finished-list:
                TaskSetItem {
                    info: info;
                    finished: true;
                    progress-mode: root.progress-mode;
                }
            
            VerticalSpacing {}
        }
    }
}