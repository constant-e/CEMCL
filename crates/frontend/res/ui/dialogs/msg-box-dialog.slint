import { StandardButton, StyleMetrics, VerticalBox } from "std-widgets.slint";
import { TitleBar, WindowFrame } from "../components/components.slint";

// User-facing error categories; the detail is passed separately as raw text
export enum MsgID {
    AccountConfig,
    AuthSession,
    Client,
    Connection,
    DirectoryNotEmpty,
    Download,
    FileAlreadyExists,
    FileBusy,
    FileNotFound,
    GameConfig,
    Interrupted,
    JavaConfig,
    JavaNotFound,
    JavaReleaseInvalid,
    LauncherConfig,
    LoginInvalid,
    Network,
    PermissionDenied,
    Request,
    InternalChannel,
    InternalSync,
    OutOfRange,
    TaskSetNotFound,
    Unknown,
}

export component MsgBoxDialog inherits Dialog {
    title: @tr("Error");
    preferred-width: 400px;
    // The title bar is drawn by the dialog itself
    no-frame: true;
    resize-border-width: 5px;
    // The dialog lays out its own content, so the built-in dialog grid must not
    // add padding: the title bar and the window border reach the window edges.
    padding: 0px;

    // Localized error category, picked by `msgid`
    in property <MsgID> msgid;
    // Raw error detail, already formatted by the caller
    in property <string> detail;

    // Call UI (Rust)
    callback drag-window();

    WindowFrame {
        width: 100%;
        height: 100%;

        VerticalBox {
            padding: 0px;
            spacing: 0px;

            title-bar := TitleBar {
                title-text: @tr("Error");
                show-minimize: false;
                show-maximize: false;
                close => { root.close(); }
                drag => { root.drag-window(); }
            }

            VerticalBox {
                description := Text {
                    wrap: word-wrap;
                }

                if (root.detail != ""): Text {
                    text: @tr("Details: {0}", root.detail);
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: StyleMetrics.layout-spacing;

                    StandardButton {
                        kind: ok;
                        clicked => root.close();
                    }
                }
            }
        }
    }

    states [
        AccountConfig when msgid == MsgID.AccountConfig: {
            description.text: @tr("Failed to load the account list: the account configuration file is invalid. Check account.json or add the account again.");
        }
        AuthSession when msgid == MsgID.AuthSession: {
            description.text: @tr("No login session was found. Please log in again.");
        }
        Client when msgid == MsgID.Client: {
            description.text: @tr("The network client returned an error. Check the download source settings and retry.");
        }
        Connection when msgid == MsgID.Connection: {
            description.text: @tr("Connection failed. Check your network connection and the download source settings.");
        }
        DirectoryNotEmpty when msgid == MsgID.DirectoryNotEmpty: {
            description.text: @tr("The target directory is not empty. Choose an empty directory.");
        }
        Download when msgid == MsgID.Download: {
            description.text: @tr("Download failed. Check your network connection and the download source settings, then retry.");
        }
        FileAlreadyExists when msgid == MsgID.FileAlreadyExists: {
            description.text: @tr("The target file already exists. Delete or rename it and retry.");
        }
        FileBusy when msgid == MsgID.FileBusy: {
            description.text: @tr("A file is in use by another program. Close the program and retry.");
        }
        FileNotFound when msgid == MsgID.FileNotFound: {
            description.text: @tr("A required file was not found. It may have been moved or deleted.");
        }
        GameConfig when msgid == MsgID.GameConfig: {
            description.text: @tr("The Minecraft version configuration is invalid. Re-add the version or check its JSON file.");
        }
        Interrupted when msgid == MsgID.Interrupted: {
            description.text: @tr("The operation was interrupted.");
        }
        JavaConfig when msgid == MsgID.JavaConfig: {
            description.text: @tr("The Java path configuration is invalid. Check the configured Java installation path.");
        }
        JavaNotFound when msgid == MsgID.JavaNotFound: {
            description.text: @tr("No Java executable was found at the configured path.");
        }
        JavaReleaseInvalid when msgid == MsgID.JavaReleaseInvalid: {
            description.text: @tr("The Java release file is invalid. Check the Java installation or reinstall Java.");
        }
        LauncherConfig when msgid == MsgID.LauncherConfig: {
            description.text: @tr("The launcher configuration (config.json) is invalid. Fix or delete it and restart the launcher.");
        }
        LoginInvalid when msgid == MsgID.LoginInvalid: {
            description.text: @tr("The saved login data is invalid. Please log in again.");
        }
        Network when msgid == MsgID.Network: {
            description.text: @tr("The network is unavailable. Check your network connection.");
        }
        PermissionDenied when msgid == MsgID.PermissionDenied: {
            description.text: @tr("Permission denied. Check the permissions of the launcher data directory.");
        }
        Request when msgid == MsgID.Request: {
            description.text: @tr("A network request failed. Check your network connection and retry.");
        }
        InternalChannel when msgid == MsgID.InternalChannel: {
            description.text: @tr("The launcher's internal communication failed. Please restart the launcher.");
        }
        InternalSync when msgid == MsgID.InternalSync: {
            description.text: @tr("The launcher's internal state synchronization failed. Please retry or restart the launcher.");
        }
        OutOfRange when msgid == MsgID.OutOfRange: {
            description.text: @tr("The selected item no longer exists. Refresh the list and try again.");
        }
        TaskSetNotFound when msgid == MsgID.TaskSetNotFound: {
            description.text: @tr("The download task was not found. It may have finished or been removed.");
        }
        Unknown when msgid == MsgID.Unknown: {
            description.text: @tr("An unknown error occurred. Check the log for details.");
        }
    ]
}
