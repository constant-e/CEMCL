import { Button, ProgressIndicator, VerticalBox } from "std-widgets.slint";
import { TitleBar, WindowFrame } from "../../components/components.slint";

export component ForgeDownloadDialog inherits Dialog {
    title: @tr("Installing Forge");
    preferred-height: 200px;
    preferred-width: 400px;
    // The title bar is drawn by the dialog itself
    no-frame: true;
    resize-border-width: 5px;
    // The dialog lays out its own buttons, so the built-in dialog grid must not
    // add padding: the title bar and the window border reach the window edges.
    padding: 0px;

    in-out property <string> message;
    in-out property <float> progress;
    in-out property <bool> installing;

    callback hide-clicked();
    callback cancel-clicked();

    // Call UI (Rust)
    callback drag-window();

    WindowFrame {
        width: 100%;
        height: 100%;

        VerticalBox {
            padding: 0px;
            spacing: 0px;

            title-bar := TitleBar {
                title-text: @tr("Installing Forge");
                show-minimize: false;
                show-maximize: false;
                close => { root.close(); }
                drag => { root.drag-window(); }
            }

            VerticalBox {
                Text {
                    text: root.installing ? @tr("Installing Forge") : message;
                    wrap: word-wrap;
                }

                ProgressIndicator {
                    progress: root.progress;
                }

                Text {
                    text: round(root.progress * 100) + "%";
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: end;

                    hide-btn := Button {
                        text: @tr("Hide");
                        clicked => { root.hide-clicked(); }
                    }

                    cancel-btn := Button {
                        text: @tr("Cancel");
                        clicked => { root.cancel-clicked(); }
                    }
                }
            }
        }
    }
}
