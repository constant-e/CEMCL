import { ComboBox } from "std-widgets.slint";

export component JavaVersionSelector inherits ComboBox {
    // A specialized ComboBox for selecting Java versions.
    // The model should contain pre-formatted Java version strings,
    // e.g. "26.0.1" or "1.8.0_500 (not compatible)".
    // Inherits: model (in-out [string]), current-index (in-out int),
    //           enabled (in bool), selected() callback.
}