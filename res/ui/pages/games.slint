import { VerticalBox, StandardTableView, HorizontalBox, Button } from "std-widgets.slint";
import { HorizontalSpacing, Title } from "../components/components.slint";

export component GamesPage inherits VerticalBox {
    in-out property <int> current-index <=> table.current-row;
    in-out property <[[StandardListViewItem]]> model <=> table.rows;

    callback click-add-btn();
    callback click-edit-btn(index: int);
    callback current-index-changed(current-index: int);

    Title { text: @tr("Minecraft Version"); }

    table := StandardTableView {
        min-width: 250px;
        columns: [
            { title: @tr("Version") },
            { title: @tr("Type") },
            { title: @tr("Description") }
        ];
        current-row-changed(current-row) => { root.current-index-changed(current-row) }
    }

    HorizontalBox {
        padding: 0px;

        HorizontalSpacing {}

        add-btn := Button {
            text: @tr("Add");
            clicked => { click-add-btn() }
        }

        edit-btn := Button {
            text: @tr("Edit");
            clicked => { click-edit-btn(current-index) }
        }
    }
}
