import { Button, StyleMetrics, VerticalBox, HorizontalBox, LineEdit } from "std-widgets.slint";
import { RoundedBackground, VerticalSpacing, HorizontalSpacing, SettingsGroup, SectionTitle, MyText, TitleBar, WindowFrame } from "../components/components.slint";

export component LoginDialog inherits Dialog {
    title: @tr("Add an Account");
    // The title bar is drawn by the dialog itself
    no-frame: true;
    resize-border-width: 5px;
    // The dialog lays out its own content, so the built-in dialog grid must not
    // add padding: the title bar and the window border reach the window edges.
    padding: 0px;

    in-out property <string> user-name;
    in-out property <string> uuid;

    callback msa-clicked();
    callback msa-ok-clicked();
    callback offline-ok-clicked(string, string);

    // Call UI (Rust)
    callback drag-window();

    WindowFrame {
        width: 100%;
        height: 100%;

        VerticalBox {
            padding: 0px;
            spacing: 0px;

            title-bar := TitleBar {
                title-text: @tr("Add an Account");
                show-minimize: false;
                show-maximize: false;
                close => { root.close(); }
                drag => { root.drag-window(); }
            }

            VerticalBox {
                RoundedBackground {
                    VerticalBox {
                        offline-group := SettingsGroup {
                            title: @tr("Offline Account");

                            Row {
                                MyText { text: @tr("Name"); }
                                LineEdit {
                                    text <=> root.user-name;
                                }
                            }

                            Row {
                                MyText { text: @tr("UUID"); }
                                LineEdit {
                                    text <=> root.uuid;
                                }
                            }
                        }
                        
                        HorizontalLayout {
                            HorizontalSpacing {}
                            Button {
                                text: @tr("OK");
                                clicked => offline-ok-clicked(user-name, uuid);
                            }
                        }
                    }
                }
                
                RoundedBackground {
                    HorizontalBox {
                        VerticalLayout {
                            SectionTitle {
                                vertical-alignment: center;
                                text: @tr("Microsoft Account");
                            }

                            Text {
                                vertical-alignment: center;
                                text: @tr("Your user code will be automatically copied.") + "\n" + @tr("Press OK after you finish logging in.");
                            }
                        }

                        VerticalSpacing { height: StyleMetrics.layout-spacing; }

                        Button {
                            text: @tr("Open in Web Browser");
                            clicked => {
                                msa-clicked();
                                msa-ok-btn.enabled = true;
                            }
                        }

                        msa-ok-btn := Button {
                            text: @tr("OK");
                            enabled: false;
                            clicked => msa-ok-clicked();
                        }
                    }
                }
            }
        }
    }
}
