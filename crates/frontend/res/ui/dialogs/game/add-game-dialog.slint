import { TitleBar, SettingsGroup, SubTitle, VerticalSpacing, MyText, MySpinBox, JavaVersionSelector, WindowFrame } from "../../components/components.slint";
import { ComboBox, StandardButton, StandardTableView, Switch, LineEdit, VerticalBox, HorizontalBox, StyleMetrics, Palette } from "std-widgets.slint";

import { MCConfig } from "game.slint";

export component AddGameDialog inherits Dialog {
    title: @tr("Add a Game");
    preferred-height: 600px;
    preferred-width: 800px;
    // The title bar is drawn by the dialog itself
    no-frame: true;
    resize-border-width: 5px;
    // The dialog lays out its own buttons, so the built-in dialog grid must not
    // add padding: the title bar and the window border reach the window edges.
    padding: 0px;

    in-out property <int> game-index <=> game-table.current-row;
    in-out property <[[StandardListViewItem]]> game-list <=> game-table.rows;
    in-out property <int> game-type <=> game-combo-box.current-index;

    in-out property <int> mod-index <=> mod-table.current-row;
    in-out property <[[StandardListViewItem]]> mod-list <=> mod-table.rows;
    in-out property <int> mod-type <=> mod-combo-box.current-index;

    in-out property <bool> game-loading: true;
    in-out property <bool> mod-loading: false;

    in-out property <MCConfig> game-config;

    // Java selector (separate from config)
    in-out property <[string]> java-combo-model;
    in-out property <int> java-index;

    callback get-default-game-config();
    callback get-game-list(int);
    // mc combo index, mc index, mod combo index
    callback get-mod-list(int, int, int);
    // mc combo, mc, mod combo, mod
    callback add-game(int, int, int, int, MCConfig);
    // Called when game selection changes, to refresh Java compatibility
    callback game-selected(int, int);
    callback cancel-clicked();

    // Call UI (Rust)
    callback drag-window();

    WindowFrame {
        width: 100%;
        height: 100%;

        VerticalBox {
            padding: 0px;
            spacing: 0px;

            title-bar := TitleBar {
                title-text: @tr("Add a Game");
                show-minimize: false;
                show-maximize: false;
                close => { root.close(); }
                drag => { root.drag-window(); }
            }

            VerticalBox {
                HorizontalBox {
                    padding: 0px;

                    VerticalBox {
                        padding: 0px;

                        SubTitle { text: @tr("Minecraft Version"); }
                        game-combo-box := ComboBox {
                            model: [@tr("All"), @tr("Release"), @tr("Snapshot"), @tr("Old Alpha"), @tr("Old Beta")];
                            selected => {
                                root.game-list = [];
                                root.game-loading = true;
                                game-table.current-row = -1;
                                root.mod-list = [];
                                root.mod-loading = false;
                                mod-table.current-row = -1;
                                root.get-game-list(self.current-index);
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            min-width: 200px;

                            VerticalBox {
                                width: 100%;
                                height: 100%;
                                padding: 0px;

                                game-table := StandardTableView {
                                    columns: [
                                        { title: @tr("Version") },
                                        { title: @tr("Type") }
                                    ];
                                    min-width: 200px;

                                    current-row-changed(row) => {
                                        if row >= 0 {
                                            root.game-selected(game-combo-box.current-index, row);
                                            root.mod-list = [];
                                            root.mod-loading = false;
                                            mod-table.current-row = -1;
                                            if mod-combo-box.current-index != 0 {
                                                root.mod-loading = true;
                                                root.get-mod-list(game-combo-box.current-index, row, mod-combo-box.current-index);
                                            }
                                        }
                                    }
                                }
                            }

                            if root.game-loading: Rectangle {
                                width: 100%;
                                height: 100%;
                                background: Palette.background;

                                Text {
                                    text: @tr("Loading...");
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    color: Palette.foreground;
                                }
                            }
                        }
                    }

                    VerticalBox {
                        padding: 0px;

                        SubTitle { text: @tr("Mod Loader"); }
                        mod-combo-box := ComboBox {
                            model: [@tr("None"), "Forge", "Fabric"];
                            selected => {
                                root.mod-list = [];
                                root.mod-loading = false;
                                mod-table.current-row = -1;
                                if self.current-index != 0 && game-table.current-row >= 0 && game-table.current-row < game-list.length {
                                    root.mod-loading = true;
                                    root.get-mod-list(game-combo-box.current-index, game-table.current-row, self.current-index);
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            min-width: 200px;

                            VerticalBox {
                                width: 100%;
                                height: 100%;
                                padding: 0px;

                                mod-table := StandardTableView {
                                    min-width: 200px;
                                    columns: [
                                        { title: @tr("Version") },
                                        { title: @tr("Modified") }
                                    ];
                                }
                            }

                            if root.mod-loading: Rectangle {
                                width: 100%;
                                height: 100%;
                                background: Palette.background;

                                Text {
                                    text: @tr("Loading...");
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    color: Palette.foreground;
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        SettingsGroup {
                            title: @tr("Customize");
                            vertical-stretch: 0;

                            Row {
                                MyText { text: @tr("Window height"); }
                                MySpinBox {
                                    value <=> game-config.height;
                                }
                            }

                            Row {
                                MyText { text: @tr("Window width"); }
                                MySpinBox {
                                    value <=> game-config.width;
                                }
                            }

                            Row {
                                MyText { text: @tr("Description"); }
                                LineEdit {
                                    text <=> game-config.description;
                                }
                            }

                            Row {
                                MyText { text: @tr("Game args"); }
                                LineEdit {
                                    text <=> game-config.game-args;
                                }
                            }

                            Row {
                                MyText { text: @tr("Java version"); }
                                JavaVersionSelector {
                                    model <=> root.java-combo-model;
                                    current-index <=> root.java-index;
                                }
                            }

                            Row {
                                MyText { text: @tr("JVM args"); }
                                LineEdit {
                                    text <=> game-config.jvm-args;
                                }
                            }

                            Row {
                                MyText { text: @tr("Wrapper"); }
                                LineEdit {
                                    text <=> game-config.wrapper;
                                }
                            }

                            Row {
                                MyText { text: @tr("Minimum memory"); }
                                LineEdit {
                                    text <=> game-config.xms;
                                }
                            }

                            Row {
                                MyText { text: @tr("Maximum memory"); }
                                LineEdit {
                                    text <=> game-config.xmx;
                                }
                            }

                            Row {
                                Switch {
                                    colspan: 2;
                                    text: @tr("Separated");
                                    checked <=> game-config.separated;
                                }
                            }
                        }

                        VerticalSpacing {}
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: StyleMetrics.layout-spacing;

                    StandardButton {
                        kind: ok;
                        enabled: !root.game-loading && !root.mod-loading && game-table.current-row >= 0 && (mod-combo-box.current-index == 0 || mod-table.current-row >= 0);
                        clicked => {
                            root.add-game(game-combo-box.current-index, game-table.current-row, mod-combo-box.current-index, mod-table.current-row, game-config);
                        }
                    }
                    StandardButton {
                        kind: cancel;
                        clicked => { root.cancel-clicked(); }
                    }
                }
            }
        }
    }
}
