import { Button, StandardTableView, VerticalBox, HorizontalBox, ProgressIndicator } from "std-widgets.slint";
import { Title, SubTitle, SideBar } from "components/components.slint";
import { AccountsPage, HomePage, GamesPage, DownloaderPage, SettingsPage, State, Settings } from "pages/pages.slint";

export { Settings, State }
export { Messages } from "messages.slint";

export component AppWindow inherits Window {
    preferred-height: 600px;
    preferred-width: 800px;
    title: "CE Minecraft Launcher";
    icon: @image-url("../pic/icon.png");

    in-out property <int> acc-index;
    in-out property <int> game-index;
    in-out property <[[StandardListViewItem]]> acc-model;
    in-out property <[[StandardListViewItem]]> game-model;
    in-out property <State> state;
    in-out property <Settings> settings;
    in-out property <string> authors;
    in-out property <string> version;
    in-out property <float> progress;

    callback click-add-acc-btn();
    callback click-add-game-btn();
    callback click-downloader-btn();
    callback click-edit-acc-btn();
    callback click-edit-game-btn();
    callback apply-settings();
    callback click-start-btn();
    
    HorizontalBox {
        side-bar := SideBar {
            title: "CEMCL";
            model: [@tr("Account"), @tr("Home"), @tr("Games"), @tr("Downloader"), @tr("Settings")];
            current-index: 1;

            property <int> last-index: 0;
            index-changed(index) => {
                if (index == 3) {
                    root.click-downloader-btn();
                }
                if (last-index == 4){
                    root.apply-settings();
                }
                last-index = index;
            }
        }

        Rectangle {
            preferred-width: 100%;
            if (side-bar.current-index == 0):  acc-page := AccountsPage { current-index: acc-index; model: acc-model; }
            if (side-bar.current-index == 1):  home-page := HomePage { state: state; }
            if (side-bar.current-index == 2):  games-page := GamesPage { current-index: game-index; model: game-model; }
            if (side-bar.current-index == 3):  downloader-page := DownloaderPage {}
            if (side-bar.current-index == 4):  settings-page := SettingsPage { settings: settings; authors: authors; version: version; }
        }
    }
}
