import { StandardButton, StyleMetrics, VerticalBox } from "std-widgets.slint";
import { TitleBar, WindowFrame } from "../components/components.slint";

export { AddGameDialog } from "game/add-game-dialog.slint";
export { MCConfig } from "game/game.slint";
export { ForgeDownloadDialog } from "game/forge-download-dialog.slint";
export { LoginDialog } from "login-dialog.slint";
export { EditGameDialog } from "game/edit-game-dialog.slint";
export { AddJavaDialog } from "add-java-dialog.slint";

export enum AskID {
    DelAccConfirm,      // Confirm to delete an account
    DelGameConfirm,     // Confirm to delete a game
}

export component AskDialog inherits Dialog {
    in property <AskID> msgid;
    in property <string> extra-str: "";
    callback yes-clicked();

    // Call UI (Rust)
    callback drag-window();

    title: root.title-text;
    // The title bar is drawn by the dialog itself
    no-frame: true;
    resize-border-width: 5px;
    // The dialog lays out its own buttons, so the built-in dialog grid must not
    // add padding: the title bar and the window border reach the window edges.
    padding: 0px;

    // Title shown in the title bar, picked by `msgid`
    private property <string> title-text;

    WindowFrame {
        width: 100%;
        height: 100%;

        VerticalBox {
            padding: 0px;
            spacing: 0px;

            title-bar := TitleBar {
                title-text: root.title-text;
                show-minimize: false;
                show-maximize: false;
                close => { root.close(); }
                drag => { root.drag-window(); }
            }

            VerticalBox {
                text := Text {}

                HorizontalLayout {
                    alignment: end;
                    spacing: StyleMetrics.layout-spacing;

                    StandardButton {
                        kind: no;
                        clicked => root.close();
                    }
                    StandardButton {
                        kind: yes;
                        clicked => {
                            root.yes-clicked();
                            root.close();
                        }
                    }
                }
            }
        }
    }

    states [
        DelAccConfirm when msgid == AskID.DelAccConfirm: {
            text.text: @tr("Are you sure to delete this account?");
            title-text: @tr("Delete Account");
        }
        DelGameConfirm when msgid == AskID.DelGameConfirm: {
            text.text: @tr("All the files under this Minecraft installation's folder will be deleted. Continue?");
            title-text: @tr("Delete Game");
        }
    ]
}
