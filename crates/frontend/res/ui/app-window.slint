import { Button, StandardTableView, VerticalBox, HorizontalBox, ProgressIndicator } from "std-widgets.slint";
import { TitleBar, SideBar } from "components/components.slint";
import { AccountsPage, HomePage, GamesPage, DownloaderPage, JavaPage, SettingsPage, State, Config, ConfigGeneral, ConfigDL, ConfigMC, TaskSetInfo } from "pages/pages.slint";
import { AccountIconSpec, AccountInner } from "pages/accounts/accounts.slint";

export { Config, ConfigGeneral, ConfigDL, ConfigMC, State }
export { AddGameDialog, EditGameDialog, AskDialog, LoginDialog, AddJavaDialog, ForgeDownloadDialog } from "dialogs/dialogs.slint";

export component AppWindow inherits Window {
    preferred-height: 600px;
    preferred-width: 800px;
    title: "CE Minecraft Launcher";
    icon: @image-url("../pic/icon.png");
    // The title bar is drawn by the app itself
    no-frame: true;
    resize-border-width: 5px;

    in-out property <int> acc-index: 0;
    in-out property <int> game-index: 0;
    in-out property <[AccountInner]> acc-list;
    in-out property <[string]> combo-box-model;
    in-out property <[[StandardListViewItem]]> game-model;
    in-out property <[[StandardListViewItem]]> java-model;
    in-out property <State> state;
    in-out property <Config> config;
    in-out property <[string]> java-combo-model;
    in-out property <int> java-index;
    in-out property <string> authors;
    in-out property <string> version;
    in-out property <float> progress;
    in-out property <int> progress-current;
    in-out property <int> progress-total;
    in-out property <[TaskSetInfo]> unfinished-list;
    in-out property <[TaskSetInfo]> finished-list;
    // Localized suffix for incompatible Java versions, read from Rust
    out property <string> not-compatible-text: @tr("not compatible");
    // Avatar icon size, read from Rust to generate the avatar bitmaps for the display scale
    out property <length> account-icon-size: AccountIconSpec.size;
    // Titles shown in the title bar, indexed like the side bar model
    property <[string]> page-titles: [
        @tr("Account"),
        "CE Minecraft Launcher",
        @tr("Minecraft Version"),
        @tr("Downloader"),
        @tr("Java Installations"),
        @tr("Settings")
    ];

    // Send command to App
    callback del-acc(int);
    callback del-game(int);
    callback del-java(int);
    callback edit-acc(int, AccountInner);
    callback set-config(Config);
    callback java-selected(int);
    callback start(int, int);
    callback switch-acc(int);
    callback switch-ver(int);
    callback pause-taskset(string);
    callback resume-taskset(string);
    callback cancel-taskset(string);
    
    // Call UI (Rust)
    callback open-add-game-dialog();
    callback open-add-java-dialog();
    callback open-edit-game-dialog(int);
    callback open-edit-java-dialog(int);
    callback open-login-dialog();
    callback drag-window();
    
    HorizontalBox {
        padding: 0px;

        side-bar := SideBar {
            header-height: title-bar.height;
            title: "CEMCL";
            model: [@tr("Account"), @tr("Home"), @tr("Games"), @tr("Downloader"), @tr("Java"), @tr("Settings")];
            current-index: 1;

            index-changed(from, to) => {
                if (from == 5){
                    root.set-config(root.config);
                }
                if (to == 3) {
                    // Download Page
                }
            }
        }

        VerticalBox {
            padding: 0px;

            title-bar := TitleBar {
                title-text: root.page-titles[side-bar.current-index];
                maximized: root.maximized;
                minimize => { root.minimized = true; }
                maximize => { root.maximized = !root.maximized; }
                close => { root.close(); }
                drag => { root.drag-window(); }
            }

            Rectangle {
                preferred-width: 100%;
                vertical-stretch: 1;

                if (side-bar.current-index == 0): acc-page := AccountsPage {
                    current-index <=> acc-index;
                    accounts <=> acc-list;
                    del-acc(index) => { del-acc(index) }
                    edit-acc(index, account) => { edit-acc(index, account) }
                    open-login-dialog() => { root.open-login-dialog() }
                    switch-acc(index) => { root.switch-acc(index) }
                }

                if (side-bar.current-index == 1): home-page := HomePage {
                    state: state;
                    index <=> game-index;
                    model: combo-box-model;
                    progress: progress;
                    progress-current: root.progress-current;
                    progress-total: root.progress-total;
                    progress-mode: root.config.general.progress-mode;
                    current-index-changed(index) => { switch-ver(index) }
                    start(index) => { start(root.acc-index, index) }
                }

                if (side-bar.current-index == 2): games-page := GamesPage {
                    current-index <=> game-index;
                    model: game-model;
                    open-add-game-dialog => { open-add-game-dialog() }
                    open-edit-game-dialog(index) => { open-edit-game-dialog(index) }
                    current-index-changed(current-index) => { switch-ver(current-index) }
                }

                if (side-bar.current-index == 3): downloader-page := DownloaderPage {
                    unfinished-list: root.unfinished-list;
                    finished-list: root.finished-list;
                    progress-mode: root.config.general.progress-mode;
                    pause(id) => { root.pause-taskset(id) }
                    resume(id) => { root.resume-taskset(id) }
                    cancel-task(id) => { root.cancel-taskset(id) }
                }

                if (side-bar.current-index == 4): java-page := JavaPage {
                    model: java-model;
                    open-add-java-dialog => { open-add-java-dialog() }
                    del-java(index) => { del-java(index) }
                    current-index-changed(current-index) => {}
                }

                if (side-bar.current-index == 5): settings-page := SettingsPage {
                    authors: authors;
                    version: version;
                    config <=> config;
                    java-combo-model <=> root.java-combo-model;
                    java-index <=> root.java-index;
                    set-config(config) => { root.set-config(config) }
                    java-selected(index) => { root.java-selected(index) }
                }
            }
        }
    }
}
